<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orkes Control Center</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .animate-fade-in {
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(5px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>

<body class="bg-slate-50 min-h-screen text-slate-800 font-sans">
    <div class="max-w-[1400px] mx-auto py-8 px-4 sm:px-6 lg:px-8">

        <!-- Topbar -->
        <div
            class="bg-white p-5 rounded-2xl shadow-sm mb-6 flex justify-between items-center border border-slate-200 border-t-4 border-t-blue-600">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Orkes Control Center</h1>
                <p class="text-sm text-slate-500 mt-1">
                    <% if (locals.wfId) { %>
                        Trạng thái: <span class="bg-blue-100 text-blue-700 font-mono px-2 py-0.5 rounded text-xs">
                            <%= wfId %>
                        </span>
                        <% } else { %>
                            Trạng thái: <span class="bg-slate-100 text-slate-600 px-2 py-0.5 rounded text-xs">Chưa khởi
                                chạy</span>
                            <% } %>
                </p>
            </div>
            <form action="/workflow/start" method="POST" class="m-0">
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2.5 px-6 rounded-full shadow-md transition-all transform hover:scale-105 flex items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z">
                        </path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    KHỞI CHẠY LUỒNG MỚI
                </button>
            </form>
        </div>

        <% if (locals.message) { %>
            <div
                class="bg-teal-50 border border-teal-200 text-teal-800 px-4 py-3 rounded-xl mb-6 shadow-sm flex items-center gap-3">
                <svg class="w-6 h-6 text-teal-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span><strong>Hệ thống:</strong>
                    <%= message %>
                </span>
            </div>
            <% } %>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

                    <!-- BÊN TRÁI: DYNAMIC MERMAID VISUALIZER -->
                    <div
                        class="col-span-12 lg:col-span-7 bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
                        <div class="bg-slate-50 h-full p-6 flex flex-col items-center justify-start overflow-y-auto"
                            style="min-height: 750px;">
                            <h2 class="text-xs font-bold text-slate-400 uppercase tracking-[0.2em] mb-6">Live Execution
                                Map (Sơ đồ hiện đại)</h2>

                            <% if (!locals.wfId) { %>
                                <div class="mt-20 text-center text-slate-400">
                                    <svg class="w-16 h-16 mx-auto mb-4 text-slate-300" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 002-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                                        </path>
                                    </svg>
                                    <p>Hãy nhấn nút "Khởi chạy luồng mới" ở góc trên.</p>
                                </div>
                                <% } else { %>
                                    <div class="mermaid w-full flex justify-center">
                                        <div class="animate-pulse text-blue-400 font-bold">Đang dựng sơ đồ từ Orkes...</div>
                                    </div>
                                    <% } %>
                        </div>
                    </div>

                    <!-- BÊN PHẢI: CONTROL PANEL & WEBHOOK LOGS -->
                    <div class="col-span-12 lg:col-span-5 flex flex-col gap-8">

                        <!-- 1. Khu vực Thao tác Form Duyệt -->
                        <div
                            class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden">
                            <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-400 to-indigo-500">
                            </div>
                            <h2 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                                <svg class="w-6 h-6 text-blue-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4">
                                    </path>
                                </svg>
                                Khu vực Xử lý
                            </h2>

                            <% if (!locals.wfId) { %>
                                <div class="text-center py-8 text-slate-400">
                                    <p>Chưa có luồng nào đang chạy.</p>
                                </div>
                                <% } else if (locals.pendingTask) { %>
                                    <div class="animate-fade-in">
                                        <div
                                            class="mb-5 bg-amber-50 border border-amber-200 p-4 rounded-xl text-amber-800 text-sm shadow-sm flex items-start gap-3">
                                            <svg class="w-5 h-5 text-amber-500 mt-0.5" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            <div>
                                                <span
                                                    class="block text-xs uppercase tracking-wider text-amber-600/80 mb-0.5">Đang
                                                    chờ thao tác</span>
                                                <span class="font-bold text-amber-900">
                                                    <%= pendingTask.referenceTaskName %>
                                                </span>
                                            </div>
                                        </div>
                                        <form action="/task/complete" method="POST">
                                            <input type="hidden" name="taskId" value="<%= pendingTask.taskId %>">
                                            <input type="hidden" name="workflowInstanceId"
                                                value="<%= pendingTask.workflowInstanceId %>">
                                            <div class="mb-4">
                                                <label
                                                    class="block text-xs font-bold mb-2 text-slate-500 uppercase tracking-wide">Ý
                                                    kiến đánh giá:</label>
                                                <textarea name="comments" rows="3" required
                                                    class="w-full border border-slate-300 rounded-xl p-3 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none transition-all resize-none shadow-inner"
                                                    placeholder="Nhập comment..."></textarea>
                                            </div>
                                            <div class="mb-6">
                                                <label
                                                    class="block text-xs font-bold mb-2 text-slate-500 uppercase tracking-wide">Quyết
                                                    định:</label>
                                                <select name="decision"
                                                    class="w-full border border-slate-300 rounded-xl p-3 bg-white text-sm focus:border-blue-500 outline-none font-semibold cursor-pointer shadow-sm">
                                                    <option value="APPROVE" class="text-emerald-600">✅ Đồng ý (Approve)
                                                    </option>
                                                    <option value="REJECT" class="text-rose-600">❌ Từ chối (Reject)
                                                    </option>
                                                </select>
                                            </div>
                                            <button type="submit"
                                                class="w-full bg-slate-800 text-white font-bold py-3.5 px-4 rounded-xl hover:bg-slate-900 shadow-md transition-all">
                                                Xác nhận Hoàn thành Task
                                            </button>
                                        </form>
                                    </div>
                                    <% } else { %>
                                        <div class="text-center py-6 text-slate-400">
                                            <svg class="w-12 h-12 mx-auto mb-2 text-emerald-400" fill="none"
                                                stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                            </svg>
                                            <p class="font-bold text-slate-600 text-base">Tất cả Task đã hoàn thành!</p>
                                            <button onclick="window.location.reload()"
                                                class="mt-4 text-xs bg-slate-100 hover:bg-slate-200 text-slate-600 font-medium py-1.5 px-4 rounded-full transition-colors border border-slate-200">Tải
                                                lại trang</button>
                                        </div>
                                        <% } %>
                        </div>

                        <!-- 2. Khu vực Lịch sử Webhook -->
                        <div class="bg-white p-7 rounded-2xl border border-slate-200 shadow-sm flex-1">
                            <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                                <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                                    </path>
                                </svg>
                                Nhật ký Webhook Notifications
                                <span class="text-xs bg-purple-100 text-purple-700 px-2 py-0.5 rounded-full font-mono">
                                    <%= locals.webhookLogs ? webhookLogs.length : 0 %> logs
                                </span>
                            </h2>
                            <div class="space-y-3 max-h-[250px] overflow-y-auto pr-2">
                                <% if (!locals.webhookLogs || webhookLogs.length===0) { %>
                                    <p class="text-xs text-slate-400 italic text-center py-4">Chưa có thông báo Webhook
                                        nào gửi đến.</p>
                                    <% } else { %>
                                        <% webhookLogs.forEach(log=> { %>
                                            <div
                                                class="bg-slate-900 text-slate-100 p-3 rounded-xl text-xs font-mono shadow-inner">
                                                <div
                                                    class="flex justify-between text-slate-400 mb-1 border-b border-slate-800 pb-1">
                                                    <span>🔔 Webhook Trigger</span>
                                                    <span>
                                                        <%= new Date(log.receivedAt).toLocaleTimeString('vi-VN') %>
                                                    </span>
                                                </div>
                                                <pre
                                                    class="text-[11px] text-green-400 overflow-x-auto"><%= JSON.stringify(log.payload, null, 2) %></pre>
                                            </div>
                                            <% }) %>
                                                <% } %>
                            </div>
                        </div>

                    </div>
                </div>
    </div>

    <!-- Data Injection -->
    <script type="application/json" id="data-workflow">
        <%- JSON.stringify(locals.workflow || locals.workflowExe || {}) %>
    </script>
    <script type="application/json" id="data-running">
        <%= locals.wfId ? "true" : "false" %>
    </script>

    <!-- HÀM VẼ BẢN ĐỒ DYNAMIC MODERN UI -->
    <script type="module">
        import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

        const wfData = JSON.parse(document.getElementById('data-workflow').textContent || '{}');
        const isRunning = document.getElementById('data-running').textContent.trim() === 'true';

        const wfDef = wfData.workflowDefinition;
        const exeTasks = wfData.tasks || [];

        function cleanString(str) {
            if (!str) return '';
            return String(str)
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;')
                .replace(/[\r\n]+/g, ' ');
        }

        // SVG MICRO ICONS (Sạch sẽ, hiện đại)
        const iconGlobe = `<svg style='width:13px;height:13px;display:inline-block;vertical-align:-2px;margin-right:5px;color:#2563eb;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M21 12a9 9 0 11-18 0 9 9 0 0118 0z'/><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M3.6 9h16.8M3.6 15h16.8'/><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M11.5 3a17 17 0 000 18M12.5 3a17 17 0 010 18'/></svg>`;
        const iconUser = `<svg style='width:13px;height:13px;display:inline-block;vertical-align:-2px;margin-right:5px;color:#4f46e5;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z'/></svg>`;
        const iconFork = `<svg style='width:13px;height:13px;display:inline-block;vertical-align:-2px;margin-right:5px;color:#94a3b8;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4'/></svg>`;
        const iconCheck = `<svg style='width:11px;height:11px;display:inline-block;vertical-align:-1px;margin-right:3px;color:#16a34a;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2.5' d='M5 13l4 4L19 7'/></svg>`;
        const iconClock = `<svg style='width:10px;height:10px;display:inline-block;vertical-align:-1px;margin-right:3px;color:#94a3b8;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z'/></svg>`;
        const iconChat = `<svg style='width:10px;height:10px;display:inline-block;vertical-align:-1px;margin-right:3px;color:#64748b;' fill='none' stroke='currentColor' viewBox='0 0 24 24'><path stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z'/></svg>`;

        function generateMermaidGraph() {
            if (!wfDef || !wfDef.tasks) return null;

            // Đặt rx/ry nhẹ 5px tạo viền vuông bo nhẹ cá tính, bỏ dáng viên thuốc tròn bầu
            let m = `graph TD
            classDef completed fill:#ffffff,stroke:#10b981,stroke-width:1.5px,color:#0f172a,rx:6px,ry:6px;
            classDef inprogress fill:#ffffff,stroke:#3b82f6,stroke-width:2px,color:#0f172a,stroke-dasharray: 4 4,rx:6px,ry:6px;
            classDef pending fill:#f8fafc,stroke:#e2e8f0,stroke-width:1px,color:#64748b,rx:6px,ry:6px;
            classDef forkjoin fill:#1e293b,stroke:#0f172a,stroke-width:1px,color:#ffffff,rx:6px,ry:6px;
            classDef startend fill:#0284c7,stroke:#0369a1,stroke-width:1px,color:#ffffff,rx:16px,ry:16px;

            Start["Start"]:::startend
        `;

            function parseOrkesTasks(tasks, parentIds) {
                let currentParents = Array.isArray(parentIds) ? parentIds : [parentIds];

                for (let task of tasks) {
                    let tId = task.taskReferenceName.replace(/[^a-zA-Z0-9_]/g, '_');

                    const exeTask = exeTasks.find(t => t.referenceTaskName === task.taskReferenceName);
                    let status = 'pending';
                    if (isRunning && exeTask) {
                        if (exeTask.status === 'COMPLETED') status = 'completed';
                        else if (exeTask.status === 'IN_PROGRESS' || exeTask.status === 'SCHEDULED') status = 'inprogress';
                    }

                    if (task.type === 'FORK_JOIN' || task.type === 'FORK_JOIN_DYNAMIC') {
                        let label = `<div style='padding:5px 10px;font-size:11px;font-weight:600;'>${iconFork}${cleanString(task.taskReferenceName)} <span style='font-size:9px;opacity:0.6;font-weight:normal;'>[FORK]</span></div>`;
                        m += `${tId}["${label}"]:::forkjoin\n`;
                        currentParents.forEach(p => m += `${p} --> ${tId}\n`);

                        let branchEnds = [];
                        if (task.forkTasks) {
                            task.forkTasks.forEach(branch => {
                                let endOfBranch = parseOrkesTasks(branch, tId);
                                if (Array.isArray(endOfBranch)) branchEnds.push(...endOfBranch);
                                else branchEnds.push(endOfBranch);
                            });
                        }
                        currentParents = branchEnds;
                    }
                    else if (task.type === 'JOIN') {
                        let label = `<div style='padding:5px 10px;font-size:11px;font-weight:600;'>${iconFork}${cleanString(task.taskReferenceName)} <span style='font-size:9px;opacity:0.6;font-weight:normal;'>[JOIN]</span></div>`;
                        m += `${tId}["${label}"]:::forkjoin\n`;
                        currentParents.forEach(p => m += `${p} --> ${tId}\n`);
                        currentParents = [tId];
                    }
                    else {
                        let typeIcon = task.type === 'HTTP' ? iconGlobe : iconUser;
                        let safeRefName = cleanString(task.taskReferenceName);

                        // Card thiết kế chuẩn Flex, có padding thoáng đãng, co giãn tự do
                        let cardHtml = `<div style='padding:10px 14px;text-align:left;min-width:210px;max-width:280px;'>`;
                        
                        // Header
                        cardHtml += `<div style='font-weight:700;font-size:12px;color:#0f172a;display:flex;align-items:center;justify-content:space-between;gap:8px;'>`;
                        cardHtml += `<span style='overflow:hidden;text-overflow:ellipsis;white-space:nowrap;'>${typeIcon}${safeRefName}</span>`;
                        cardHtml += `<span style='font-size:9px;padding:2px 6px;background:#f1f5f9;color:#64748b;border-radius:4px;font-weight:600;flex-shrink:0;'>${task.type}</span>`;
                        cardHtml += `</div>`;

                        // Body thông tin hoàn thành
                        if (status === 'completed' && exeTask?.outputData) {
                            const out = exeTask.outputData;
                            const by = cleanString(out.processedBy || 'System');
                            const decision = out.decision ? cleanString(out.decision) : '';
                            const comment = cleanString(out.comments || 'No comment');
                            const time = out.completedAt ? new Date(out.completedAt).toLocaleTimeString('vi-VN') : 'N/A';

                            const decisionBg = decision === 'APPROVE' ? '#dcfce7' : '#ffe4e6';
                            const decisionFg = decision === 'APPROVE' ? '#15803d' : '#be123c';

                            cardHtml += `<div style='margin-top:8px;padding-top:8px;border-top:1px solid #f1f5f9;font-size:11px;'>`;
                            cardHtml += `<div style='display:flex;align-items:center;justify-content:space-between;margin-bottom:4px;'>`;
                            cardHtml += `<span style='color:#334155;font-weight:600;'>${iconCheck}${by}</span>`;
                            if (decision) {
                                cardHtml += `<span style='font-size:9px;font-weight:700;padding:1px 5px;background:${decisionBg};color:${decisionFg};border-radius:3px;'>${decision}</span>`;
                            }
                            cardHtml += `</div>`;
                            cardHtml += `<div style='color:#475569;margin-bottom:4px;word-break:break-word;line-height:1.3;'>${iconChat}<i>&quot;${comment}&quot;</i></div>`;
                            cardHtml += `<div style='color:#94a3b8;font-size:10px;'>${iconClock}${time}</div>`;
                            cardHtml += `</div>`;
                        } else if (status === 'inprogress') {
                            cardHtml += `<div style='margin-top:8px;padding-top:6px;border-top:1px solid #f1f5f9;font-size:11px;color:#2563eb;font-weight:500;'>`;
                            cardHtml += `⏳ <i>Đang chờ xử lý...</i>`;
                            cardHtml += `</div>`;
                        }

                        cardHtml += `</div>`;

                        // Dùng shape vuông ["..."] thay cho dáng trứng tròn bầu
                        m += `${tId}["${cardHtml}"]:::${status}\n`;
                        currentParents.forEach(p => m += `${p} --> ${tId}\n`);
                        currentParents = [tId];
                    }
                }
                return currentParents;
            }

            let finalNodes = parseOrkesTasks(wfDef.tasks, "Start");
            m += `End["End"]:::startend\n`;
            finalNodes.forEach(p => m += `${p} --> End\n`);

            return m;
        }

        async function renderGraph() {
            if (!isRunning) return;

            const container = document.querySelector('.mermaid');
            const graphString = generateMermaidGraph();

            if (!graphString) {
                container.innerHTML = '<p class="text-slate-400">Không tìm thấy định nghĩa Workflow từ API.</p>';
                return;
            }

            try {
                mermaid.initialize({
                    startOnLoad: false,
                    theme: 'base',
                    flowchart: {
                        htmlLabels: true,
                        curve: 'basis',
                        nodeSpacing: 35,
                        rankSpacing: 50,
                        padding: 12
                    },
                    themeVariables: {
                        fontFamily: 'Inter, system-ui, sans-serif',
                        fontSize: '12px'
                    }
                });

                const { svg } = await mermaid.render('orkes-graph-' + Date.now(), graphString);
                container.innerHTML = svg;
            } catch (error) {
                console.error('❌ Lỗi render Mermaid:', error);
                container.innerHTML = `
                    <div class="text-red-600 text-sm mb-3 font-medium">Lỗi render sơ đồ. Mở Console (F12) để xem chi tiết.</div>
                    <textarea class="w-full text-xs p-3 h-72 border border-red-200 bg-red-50 rounded-xl font-mono" readonly>${graphString}</textarea>
                `;
            }
        }

        renderGraph();
    </script>
</body>

</html>